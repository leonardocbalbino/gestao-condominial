{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_*",
        "APP_*",
        "JWT_*",
        "SMTP_*",
        "REDIS_*",
        "S3_*",
        "PAYMENT_*",
        "PLATFORM_*"
      ]
    }
  }
}
