# Copie para apps/api/.env. Valores fictícios, válidos só com infra/docker-compose.yml.
NODE_ENV=development
PORT=3333
LOG_LEVEL=info
TRUST_PROXY=false

# Superusuário: usado apenas por `pnpm db:bootstrap` para criar papéis e bancos.
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
# Dono do schema: roda migrações. Nunca usado pela API em runtime.
DATABASE_OWNER_URL=postgres://app_owner:dev-owner-password@localhost:5432/condo
# Papel da API (sujeito a RLS).
DATABASE_URL=postgres://app_user:dev-app-password@localhost:5432/condo
# Papel do caminho de super admin (/platform).
DATABASE_PLATFORM_URL=postgres://app_platform:dev-platform-password@localhost:5432/condo

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-chars
# 32 bytes em base64. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

SMTP_URL=smtp://localhost:1025
MAIL_FROM="Gestão Condominial <nao-responda@condominio.local>"
APP_WEB_URL=http://localhost:3000

# Storage dos comprovantes (MinIO do docker-compose; bucket criado com versionamento).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=condo-attachments
S3_ACCESS_KEY_ID=minio-dev
S3_SECRET_ACCESS_KEY=minio-dev-password
S3_FORCE_PATH_STYLE=true
AUTH_RATE_LIMIT_PER_MINUTE=10

# Senha dos usuários de demonstração criados por `pnpm db:seed` (somente dev).
SEED_DEV_PASSWORD=senha-de-desenvolvimento-123

# Opcional: habilita exportação de traces OpenTelemetry.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
